{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openweightmodels.eu/change-history.schema.json",
  "title": "OWM Model Change History",
  "type": "object",
  "required": [
    "model_id",
    "model_name",
    "history_start",
    "monitored_fields",
    "events"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "history_start": {
      "type": "string",
      "format": "date"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "type",
          "summary"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}